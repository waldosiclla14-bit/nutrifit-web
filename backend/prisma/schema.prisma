// NutriFit ERP — Prisma Schema
// Adaptado para: sin pasarela, entrega en metro, productos con variantes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
// AUTENTICACIÓN Y USUARIOS
// ───────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(SELLER)
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashMovements CashMovement[]
  openedRegisters CashRegister[]  @relation("RegistersOpened")
  ordersCreated Order[]        @relation("CreatedBy")
  auditLogs     AuditLog[]

  @@map("users")
}

enum Role {
  ADMIN
  SELLER
  DELIVERY
}

// ───────────────────────────────────────────────
// CLIENTES (CRM básico)
// ───────────────────────────────────────────────

model Customer {
  id          String    @id @default(uuid())
  name        String
  email       String?
  phone       String
  rut         String?   @unique
  instagram   String?
  birthDate   DateTime?
  notes       String?
  isVip       Boolean   @default(false)
  totalSpent  Int       @default(0)
  totalOrders Int       @default(0)
  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders    Order[]
  addresses Address[]
  coupons   Coupon[]
  reminders Reminder[]
  deliveries Delivery[]

  @@index([createdAt])
  @@map("customers")
}

enum ReminderStatus {
  PENDING
  DONE
}

model Reminder {
  id         String         @id @default(uuid())
  customerId String
  title      String
  message    String
  dueAt      DateTime
  status     ReminderStatus @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status, dueAt])
  @@map("reminders")
}

model Address {
  id           String @id @default(uuid())
  customerId   String
  metroLine    String
  metroStation String
  details      String?
  isDefault    Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

// ───────────────────────────────────────────────
// PROVEEDORES
// ───────────────────────────────────────────────

model Supplier {
  id           String      @id @default(uuid())
  name         String
  rut          String?     @unique
  email        String?
  phone        String?
  address      String?
  city         String?
  contactInfo  String?
  contactPerson String?
  notes        String?
  paymentTerms PaymentTerm @default(CONTADO)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  products  Product[]
  purchases Purchase[]

  @@map("suppliers")
}

enum PaymentTerm {
  CREDITO
  CONTADO
}

// ───────────────────────────────────────────────
// COMPRAS — Enumeraciones
// ───────────────────────────────────────────────

enum DocumentType {
  FACTURA
  BOLETA
  NOTA_VENTA
  GUIA_DESPACHO
  ORDEN_COMPRA
  OTRO
}

enum PurchaseStatus {
  DRAFT
  PENDING_REVIEW
  CONFIRMED
  RECEIVING
  RECEIVED
  CANCELLED
}

enum ReceiptStatus {
  PENDING
  PARTIAL
  COMPLETED
}

// ───────────────────────────────────────────────
// COMPRAS — Modelos
// ───────────────────────────────────────────────

model Purchase {
  id                String         @id @default(uuid())
  purchaseNumber    String         @unique
  supplierId        String?
  status            PurchaseStatus @default(DRAFT)

  documentType      DocumentType?
  documentNumber    String?
  documentDate      DateTime?
  paymentMethod     String?
  currency          String         @default("CLP")

  subtotal          Int            @default(0)
  tax               Int            @default(0)
  discount          Int            @default(0)
  total             Int            @default(0)

  notes             String?
  ocrRawData        Json?
  ocrConfidence     Float?
  humanCorrections  Json?

  receiptStatus     ReceiptStatus  @default(PENDING)
  receivedAt        DateTime?
  confirmedAt       DateTime?
  confirmedById     String?

  idempotencyKey    String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  items             PurchaseItem[]
  documents         PurchaseDocument[]
  receipts          GoodsReceipt[]
  costHistory       ProductCostHistory[]

  @@index([status])
  @@index([supplierId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([purchaseNumber])
  @@map("purchases")
}

model PurchaseItem {
  id              String   @id @default(uuid())
  purchaseId      String
  productId       String?
  variantId       String?

  productName     String
  variantName     String?
  sku             String?
  barcode         String?

  quantity        Int
  unitCost        Int
  discount        Int      @default(0)
  tax             Int      @default(0)
  totalCost       Int

  receivedQty     Int      @default(0)

  notes           String?
  ocrConfidence   Float?
  ocrRawData      Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchase        Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id])
  variant         ProductVariant?  @relation(fields: [variantId], references: [id])
  receiptItems    GoodsReceiptItem[]

  @@index([purchaseId])
  @@index([productId])
  @@index([variantId])
  @@map("purchase_items")
}

model PurchaseDocument {
  id              String   @id @default(uuid())
  purchaseId      String
  documentType    String
  fileName        String
  originalName    String?
  mimeType        String
  fileSize        Int
  storagePath     String

  ocrProcessed    Boolean  @default(false)
  ocrRawData      Json?
  ocrConfidence   Float?

  createdAt       DateTime @default(now())

  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_documents")
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  purchaseId      String
  receiptNumber   String   @unique
  status          ReceiptStatus @default(PENDING)

  notes           String?
  receivedAt      DateTime @default(now())
  receivedById    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchase        Purchase          @relation(fields: [purchaseId], references: [id])
  items           GoodsReceiptItem[]

  @@index([purchaseId])
  @@index([status])
  @@index([receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              String   @id @default(uuid())
  receiptId       String
  purchaseItemId  String
  variantId       String?

  expectedQty     Int
  receivedQty     Int
  damagedQty      Int      @default(0)
  notes           String?

  createdAt       DateTime @default(now())

  receipt         GoodsReceipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseItem    PurchaseItem     @relation(fields: [purchaseItemId], references: [id])
  variant         ProductVariant?  @relation(fields: [variantId], references: [id])

  @@index([receiptId])
  @@index([purchaseItemId])
  @@map("goods_receipt_items")
}

model ProductCostHistory {
  id              String   @id @default(uuid())
  productId       String?
  variantId       String?
  purchaseId      String?

  quantity        Int
  unitCost        Int
  totalCost       Int
  previousCost    Int?
  newAverageCost  Int?

  purchaseDate    DateTime @default(now())
  createdAt       DateTime @default(now())

  product         Product?         @relation(fields: [productId], references: [id])
  variant         ProductVariant?  @relation(fields: [variantId], references: [id])
  purchase        Purchase?        @relation(fields: [purchaseId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([purchaseId])
  @@index([purchaseDate])
  @@map("product_cost_history")
}

// ───────────────────────────────────────────────
// CATEGORÍAS, MARCAS Y PRODUCTOS
// ───────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)

  products Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  isActive Boolean   @default(true)

  products Product[]

  @@map("brands")
}

model Product {
  id                String   @id @default(uuid())
  sku               String   @unique
  barcode           String?  @unique
  name              String
  slug              String   @unique
  description       String?
  basePrice         Int
  costPrice         Int      @default(0)
  comparePrice      Int?
  registroIsp       String?
  imageUrl          String?
  isActive          Boolean  @default(true)
  isFeatured        Boolean  @default(false)
  categoryId        String
  brandId           String?
  lowStockThreshold Int?     // null = use global default (5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  brand      Brand?           @relation(fields: [brandId], references: [id])
  variants   ProductVariant[]
  orderItems OrderItem[]
  supplier   Supplier?        @relation(fields: [supplierId], references: [id])
  supplierId String?
  stockAdjustments StockAdjustment[]
  purchaseItems PurchaseItem[]
  costHistory    ProductCostHistory[]

  @@index([isActive])
  @@index([categoryId])
  @@index([createdAt])
  @@index([supplierId])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(uuid())
  productId         String
  sku               String @unique
  barcode           String?  @unique
  variantName       String
  attributes        Json
  price             Int?
  costPrice         Int?    @default(0)       // costo interno de última compra
  physicalStock     Int     @default(0) @map("stock")  // stock físico interno
  reservedStock     Int     @default(0)       // reservado para pedidos/ventas
  publicStock       Int     @default(0)       // stock público visible en landing
  publicPublished   Boolean @default(false) // controla si stock público es visible
  imageUrl          String?
  isActive          Boolean @default(true)
  lowStockAlert     Int     @default(5)       // umbral de alerta stock bajo

  product               Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches               Batch[]
  orderItems           OrderItem[]
  inventoryMovements   InventoryMovement[]
  stockAdjustments     StockAdjustment[]
  purchaseItems        PurchaseItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  costHistory          ProductCostHistory[]

  @@index([productId])
  @@index([isActive])
  @@index([productId, isActive])
  @@index([isActive, publicPublished])
  @@map("product_variants")
}

model Batch {
  id         String   @id @default(uuid())
  variantId  String
  batchCode  String
  quantity   Int
  expiryDate DateTime
  createdAt  DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([expiryDate])
  @@map("batches")
}

// ───────────────────────────────────────────────
// ÓRDENES (sin pasarela integrada)
// ───────────────────────────────────────────────

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  idempotencyKey  String?       @unique
  customerId      String
  customerName    String
  customerPhone   String
  customerRut     String?
  deliveryType    DeliveryType  @default(METRO)
  metroLine       String?
  metroStation    String?
  deliveryDay     String?
  deliveryTime    String?
  deliveryDetails String?
  subtotal        Int
  discount        Int           @default(0)
  couponCode      String?
  shippingCost    Int           @default(0)
  total           Int
  totalCost       Int           @default(0)
  profit          Int           @default(0)
  profitMargin    Float         @default(0)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  paymentProofUrl String?
  paymentNotes    String?
  paidAt          DateTime?
  status          OrderStatus   @default(PENDING)
  needsInvoice    Boolean       @default(false)
  invoiceType     InvoiceType?
  invoiceFolio    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  scheduledAt     DateTime?     // fecha para la cual está agendado (state=AGENDADO)
  soldAt          DateTime?     // fecha que efectivamente fue venta (cuando confirma)

  createdById     String?
  cashRegisterId  String?

  customer             Customer            @relation(fields: [customerId], references: [id])
  items                OrderItem[]
  createdBy            User?               @relation("CreatedBy", fields: [createdById], references: [id])
  inventoryMovements   InventoryMovement[]
  delivery             Delivery?

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerId])
  @@index([cashRegisterId])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@map("orders")
}

model Coupon {
  id             String   @id @default(uuid())
  code           String   @unique
  customerId     String?
  customerName   String
  customerPhone  String
  discountPercent Int
  expiresAt      DateTime?
  usedAt         DateTime?
  usedOrderId    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([isActive, expiresAt])
  @@map("coupons")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  variantId   String?
  productName String
  variantName String
  sku         String
  unitPrice   Int
  unitCost    Int    @default(0)
  quantity    Int
  total       Int
  profit      Int    @default(0)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

enum DeliveryType {
  METRO
  RETIRO_TIENDA
  ENVIO_DOMICILIO
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  TRANSFERENCIA
  EFECTIVO
  FLOW_MANUAL
  MERCADOPAGO_MANUAL
  TARJETA_MANUAL
  MIXTO
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  PREPARING
  READY
  DELIVERED
  CANCELLED
  RETURNED
  AGENDADO
}

enum InvoiceType {
  BOLETA
  FACTURA
}

// ───────────────────────────────────────────────
// CAJA / POS
// ───────────────────────────────────────────────

model CashRegister {
  id            String    @id @default(uuid())
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  openedById    String
  initialAmount Int
  finalAmount   Int?
  expectedAmount Int?
  difference    Int?
  isOpen        Boolean   @default(true)

  openedBy  User           @relation("RegistersOpened", fields: [openedById], references: [id])
  movements CashMovement[]

  @@index([isOpen])
  @@map("cash_registers")
}

model CashMovement {
  id          String          @id @default(uuid())
  registerId  String
  type        CashMovementType
  amount      Int
  reason      String
  orderId     String?
  createdById String
  createdAt   DateTime        @default(now())

  register  CashRegister @relation(fields: [registerId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])

  @@index([registerId])
  @@index([createdById])
  @@index([type, createdAt])
  @@map("cash_movements")
}

enum CashMovementType {
  INCOME
  EXPENSE
}

// ───────────────────────────────────────────────
// AUDITORÍA
// ───────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user   User?  @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ───────────────────────────────────────────────
// CONFIGURACIÓN
// ───────────────────────────────────────────────

model Config {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("config")
}

// ───────────────────────────────────────────────
// RESEÑAS
// ───────────────────────────────────────────────

model Review {
  id          String   @id @default(uuid())
  productSlug String
  name        String
  rating      Int
  text        String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productSlug])
  @@map("reviews")
}

// ───────────────────────────────────────────────
// CONTADOR ATÓMICO PARA orderNumber
// ───────────────────────────────────────────────

model OrderCounter {
  id      Int @id @default(1)
  current Int @default(0)

  @@map("order_counters")
}

enum MovementType {
  PURCHASE
  PURCHASE_RECEIPT
  SALE
  RESERVATION
  RELEASE
  CANCEL
  RETURN
  DAMAGE
  ADJUSTMENT
  RESTOCK
}

model InventoryMovement {
  id             String       @id @default(uuid())
  variantId      String
  type           MovementType
  quantity       Int
  previousStock  Int
  newStock       Int
  orderId        String?
  purchaseId     String?
  receiptId      String?
  userId         String?
  notes          String?
  unitCost       Int?
  createdAt      DateTime     @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])
  order   Order?         @relation(fields: [orderId], references: [id])

  @@index([variantId])
  @@index([orderId])
  @@index([purchaseId])
  @@index([createdAt])
  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ───────────────────────────────────────────────
// AJUSTES DE STOCK (Fase 2)
// ───────────────────────────────────────────────

enum AdjustmentReason {
  INGRESO_COMPRA
  CONTEO_FISICO
  MERMA
  DEVOLUCION
}

model StockAdjustment {
  id             String           @id @default(uuid())
  productId      String
  variantId      String?
  quantityDelta  Int              // positive = ingreso, negative = merma/devolución
  reason         AdjustmentReason
  notes          String?
  createdById    String?
  createdAt      DateTime         @default(now())

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([reason, createdAt])
  @@index([createdAt])
  @@map("stock_adjustments")
}

// ───────────────────────────────────────────────
// NUTRIFIT DELIVERY — Estaciones Metro
// ───────────────────────────────────────────────

model MetroStation {
  id                  String   @id @default(uuid())
  name                String
  normalizedName      String
  line                String
  lineName            String
  commune             String
  latitude            Float
  longitude           Float
  active              Boolean  @default(true)
  deliveryEnabled     Boolean  @default(true)
  defaultMeetingPoint String?
  notes               String?
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  deliveries Delivery[]

  @@unique([name, line])
  @@index([line])
  @@index([commune])
  @@index([active, deliveryEnabled])
  @@index([normalizedName])
  @@map("metro_stations")
}

// ───────────────────────────────────────────────
// NUTRIFIT DELIVERY — Entregas
// ───────────────────────────────────────────────

enum DeliveryStatus {
  CREATED
  PAYMENT_CONFIRMED
  PREPARING
  READY
  SCHEDULED
  CONFIRMATION_PENDING
  CONFIRMED
  IN_ROUTE
  ARRIVED
  DELIVERED
  CANCELLED
  RESCHEDULED
  CUSTOMER_UNAVAILABLE
  NOT_DELIVERED
  INCIDENT
}

model Delivery {
  id              String          @id @default(uuid())
  orderId         String          @unique
  customerId      String
  deliveryType    DeliveryType

  stationId       String?
  address         String?

  deliveryDate    DateTime?
  windowStart     String?
  windowEnd       String?

  meetingPoint    String?
  notes           String?

  status          DeliveryStatus  @default(CREATED)

  calendarEventId String?
  routeId         String?
  routeSequence   Int?

  assignedTo      String?

  deliveryCode    String          @default(uuid())

  confirmedAt     DateTime?
  startedAt       DateTime?
  arrivedAt       DateTime?
  deliveredAt     DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  order    Order         @relation(fields: [orderId], references: [id])
  customer Customer      @relation(fields: [customerId], references: [id])
  station  MetroStation? @relation(fields: [stationId], references: [id])
  auditLogs DeliveryAuditLog[]

  @@index([orderId])
  @@index([customerId])
  @@index([stationId])
  @@index([status])
  @@index([deliveryDate])
  @@index([assignedTo])
  @@index([status, deliveryDate])
  @@index([deliveryDate, windowStart])
  @@map("deliveries")
}

model DeliveryAuditLog {
  id          String   @id @default(uuid())
  deliveryId  String
  userId      String?
  action      String
  oldValue    Json?
  newValue    Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId])
  @@index([createdAt])
  @@map("delivery_audit_log")
}

// ───────────────────────────────────────────────
// FINANZAS — Gastos operacionales (P&L)
// Ingresos/COGS salen de Order+Purchase existentes; aquí solo lo nuevo.
// ───────────────────────────────────────────────

model ExpenseCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id          String    @id @default(uuid())
  categoryId  String?
  description String
  amount      Int
  spentAt     DateTime  @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([spentAt])
  @@index([categoryId])
  @@map("expenses")
}

// ───────────────────────────────────────────────
// NUTRIFIT DELIVERY — Configuración
// ───────────────────────────────────────────────

model DeliverySettings {
  id                       String @id @default(uuid())
  key                      String @unique
  value                    Json

  @@map("delivery_settings")
}
